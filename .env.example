# RailSync AI Environment Configuration
APP_NAME=RailSync AI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (Default: SQLite WAL mode in data/railsync.db)
DATABASE_URL=sqlite:///./data/railsync.db

# LAYA Decision Engine Adapter
# Options: "live" (loads convaiinnovations/laya), "mock" (calibrated fast local fallback), "finetuned"
LAYA_MODE=mock
LAYA_MODEL_PATH=convaiinnovations/laya
LAYA_FINETUNED_PATH=./models/laya-ir-checkpoint
LAYA_DEVICE=cpu

# Block Planner Mode
# Options: "ortools" (Google OR-Tools CP-SAT solver), "deterministic" (heuristic search)
PLANNER_DEFAULT_SOLVER=ortools
PLANNING_HORIZON_HOURS=48

# Speech-to-Text Pipeline (ASR)
# Options: "whisper", "sarvam", "mock"
ASR_ENGINE=mock
SARVAM_API_KEY=
SARVAM_ENDPOINT=https://api.sarvam.ai/speech-to-text

# Operational Safety
REQUIRE_HUMAN_CONTROLLER_APPROVAL=True
ADVISORY_MODE=True
